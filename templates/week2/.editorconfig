# EditorConfig — общие правила для всех редакторов: https://editorconfig.org
# VS Code: расширение EditorConfig for VS Code. PhpStorm: поддержка встроена.
# Apache NetBeans .editorconfig не читает — те же правила задаются в свойствах проекта (Formatting).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,json,yml,yaml}]
indent_size = 4

[*.md]
# в Markdown два пробела в конце строки — это перенос строки
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
